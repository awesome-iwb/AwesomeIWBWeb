[Unit]
Description=AwesomeIWB verified media and database backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/
EnvironmentFile=-/etc/awesomeiwb/media-backup.env
ExecStart=/usr/bin/bash /usr/local/lib/awesomeiwb-media/backup-media.sh
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
